{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/cron/reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/calendars",
      "schedule": "0 7 * * *"
    }
  ]
}
